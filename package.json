{
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@wdio/allure-reporter": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "allure-commandline": "^2.34.1",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "wdio:pixel6": "wdio run config/wdio.pixel6.conf.js",
    "wdio:galaxys24": "wdio run config/wdio.galaxys24.conf.js",
    "wdio:all": "npm run wdio:pixel6 && npm run wdio:galaxys24",
    "wdio:single:file:pixel6": "wdio run config/wdio.pixel6.conf.js --spec ./test/specs/swipe.spec.js",
    "wdio:single:file:galaxys24": "wdio run config/wdio.galaxys24.conf.js --spec ./test/specs/swipe.spec.js",
    "allure:report:generate": "allure generate ./allure-results --clean",
    "allure:report:open": "npx allure open allure-report",
    "clean:allure": "rimraf allure-results allure-report"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  }
}
